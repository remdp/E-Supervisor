        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="titleData"
            app:argType="com.euromix.esupervisor.screens.main.tabs.TitleData" />

    </fragment>
    <fragment
        android:id="@+id/visitSupervisorCheckOutFragment"
        android:name="com.euromix.esupervisor.screens.main.tabs.visitsSupervisors.checkOut.VisitSupervisorCheckOutFragment"
        android:label="VisitSupervisorCheckOutFragment" >
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="titleData"
            app:argType="com.euromix.esupervisor.screens.main.tabs.TitleData" />

    </fragment>
    <fragment
        android:id="@+id/storeCheckTopLevelFragment"
        android:name="com.euromix.esupervisor.screens.main.tabs.visitsSupervisors.storecheck.topLevel.StoreCheckTopLevelFragment"
        android:label="StoreCheckTopLevelFragment" >
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="titleData"
            app:argType="com.euromix.esupervisor.screens.main.tabs.TitleData" />
        <action
            android:id="@+id/action_storeCheckTopLevelFragment_to_storeCheckLowerLevelFragment"
            app:destination="@id/storeCheckLowerLevelFragment" />
        <action
            android:id="@+id/action_storeCheckTopLevelFragment_to_visitsSupervisorSalesFragment"
            app:destination="@id/visitsSupervisorSalesFragment" />
        <argument
            android:name="twoLevels"
            app:argType="boolean" />
    </fragment>
    <fragment
        android:id="@+id/storeCheckLowerLevelFragment"
        android:name="com.euromix.esupervisor.screens.main.tabs.visitsSupervisors.storecheck.lowerLevel.StoreCheckLowerLevelFragment"
        android:label="StoreCheckLowerLevelFragment" >
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="titleData"
            app:argType="com.euromix.esupervisor.screens.main.tabs.TitleData" />
        <argument
            android:name="topLevelId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="null" />
        <argument
            android:name="topLevelServerType"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="null" />
        <action
            android:id="@+id/action_storeCheckLowerLevelFragment_to_visitsSupervisorSalesFragment"
            app:destination="@id/visitsSupervisorSalesFragment" />
        <action
            android:id="@+id/action_storeCheckLowerLevelFragment_to_createTasksForStorecheckFragment"
            app:destination="@id/createTasksForStorecheckFragment" />
        <argument
            android:name="twoLevels"
            app:argType="boolean" />
