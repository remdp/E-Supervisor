<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/visits_supervisors_graph"
    app:startDestination="@id/visitsSupervisorsListFragment">

    <fragment
        android:id="@+id/visitsSupervisorsListFragment"
        android:name="com.euromix.esupervisor.screens.main.tabs.visitsSupervisors.list.VisitsSupervisorListFragment"
        android:label="VisitsSupervisorsListFragment" >
        <action
            android:id="@+id/action_visitsSupervisorsListFragment_to_visitSupervisorDetailFragment"
            app:destination="@id/visitSupervisorDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/visitSupervisorDetailFragment"
        android:name="com.euromix.esupervisor.screens.main.tabs.visitsSupervisors.detail.VisitSupervisorDetailFragment"
        android:label="VisitSupervisorDetailFragment" >
        <argument
            android:name="id"
            app:argType="string" />
        <argument
            android:name="titleData"
            app:argType="com.euromix.esupervisor.screens.main.tabs.TitleData" />
        <action
            android:id="@+id/action_visitSupervisorDetailFragment_to_visitSupervisorCheckInFragment"
            app:destination="@id/visitSupervisorCheckInFragment" />
        <action
            android:id="@+id/action_visitSupervisorDetailFragment_to_storeCheckTopLevelFragment"
            app:destination="@id/storeCheckTopLevelFragment" />
        <argument
            android:name="storeChecks"
            app:argType="com.euromix.esupervisor.app.model.common.entities.ServerPair[]"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_visitSupervisorDetailFragment_to_storeCheckLowerLevelFragment"
            app:destination="@id/storeCheckLowerLevelFragment" />
        <action
            android:id="@+id/action_visitSupervisorDetailFragment_to_visitSupervisorCheckOutFragment"
            app:destination="@id/visitSupervisorCheckOutFragment" />
        <action
            android:id="@+id/action_visitSupervisorDetailFragment_to_taskDetailFragment"
            app:destination="@id/taskDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/visitSupervisorCheckInFragment"
        android:name="com.euromix.esupervisor.screens.main.tabs.visitsSupervisors.checkIn.VisitSupervisorCheckInFragment"
