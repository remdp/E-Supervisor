<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/clAppbarBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvOutletLabel"
                style="@style/Text.Label.16.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/DP_32"
                android:layout_marginTop="@dimen/DP_32"
                android:layout_marginEnd="@dimen/DP_32"
                android:text="@string/outlet"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvOutlet"
                style="@style/Text.Label.18"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/DP_32"
                android:layout_marginTop="@dimen/DP_32"
                android:layout_marginEnd="@dimen/DP_32"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvOutletLabel"
                tools:text="Точка на ринку Солодкий формат'ринок Народний, м.Львів, вул.Червоної Калини, буд. 94" />

            <TextView
                android:id="@+id/tvOutletCoordinates"
                style="@style/Text.Label.16.Gray500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/DP_32"
                android:layout_marginTop="12dp"
                android:drawablePadding="@dimen/DP_8"
                app:drawableStartCompat="@drawable/ic_coordinate"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvOutlet"
                tools:text="48.463118, 35.053267" />

            <View
                android:id="@+id/vDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/DP_1"
                android:layout_marginTop="24dp"
                android:background="@color/gray_200"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvOutletCoordinates" />

            <TextView
                android:id="@+id/tvCurrentLocationLabel"
                style="@style/Text.Label.16.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/DP_32"
                android:layout_marginTop="@dimen/DP_32"
                android:layout_marginEnd="@dimen/DP_32"
                android:text="@string/current_location"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vDivider" />

            <TextView
                android:id="@+id/tvCurrentLocation"
                style="@style/Text.Label.18"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/DP_32"
                android:layout_marginTop="@dimen/DP_32"
                android:layout_marginEnd="@dimen/DP_32"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCurrentLocationLabel"
                tools:text="Точка на ринку Солодкий формат'ринок Народний, м.Львів, вул.Червоної Калини, буд. 94" />

            <TextView
                android:id="@+id/tvCurrentCoordinates"
                style="@style/Text.Label.16.Gray500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/DP_32"
                android:layout_marginTop="@dimen/DP_16"
                android:drawablePadding="@dimen/DP_8"
                app:drawableStartCompat="@drawable/ic_coordinate"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCurrentLocation"
                tools:text="48.463118, 35.053267" />

            <ImageButton
                android:id="@+id/ibUpdate"
                android:layout_width="@dimen/DP_32"
                android:layout_height="@dimen/DP_32"
                android:layout_marginEnd="@dimen/DP_32"
                android:background="@drawable/bg_8dp_blue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvCurrentCoordinates"
                app:srcCompat="@drawable/ic_update" />

            <TextView
                android:id="@+id/tvDateCoordinates"
                style="@style/Text.Label.16.Gray500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/DP_32"
                android:layout_marginTop="@dimen/DP_8"
                android:drawablePadding="@dimen/DP_8"
                app:drawableStartCompat="@drawable/ic_calendar_dot"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCurrentCoordinates"
                tools:text="24.10.2024, 09.30" />

            <TextView
                android:id="@+id/tvCoordinateDeviation"
                style="@style/Text.Label.16.Gray500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/DP_32"
                android:layout_marginTop="@dimen/DP_8"
                android:drawablePadding="@dimen/DP_8"
                app:drawableStartCompat="@drawable/ic_location_mark"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDateCoordinates"
                tools:text="4m" />

            <TextView
                android:id="@+id/tvOutletTime"
                style="@style/Text.Label.16.Gray500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/DP_8"
                android:layout_marginStart="@dimen/DP_32"
                android:drawablePadding="@dimen/DP_8"
                app:drawableStartCompat="@drawable/ic_clock_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCoordinateDeviation"
                tools:text="0:45" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAppbarBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:paddingStart="@dimen/DP_8"
        android:paddingTop="@dimen/DP_8"
        android:paddingEnd="@dimen/DP_8"
        android:paddingBottom="@dimen/DP_8"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible">

        <Button
            android:id="@+id/btnCancel"
            style="@style/Text.Label.14.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/DP_8"
            android:backgroundTint="@color/white"
            android:paddingTop="@dimen/DP_12"
            android:paddingBottom="@dimen/DP_12"
            android:text="@string/cancel"
            android:textColor="@color/blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnSaveCheckIn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/blue"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/btnSaveCheckIn"
            style="@style/Text.Label.14.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/DP_12"
            android:paddingBottom="@dimen/DP_12"
            android:text="@string/save"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnCancel"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <com.euromix.esupervisor.app.views.ResultView
        android:id="@+id/vResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone" />


</androidx.constraintlayout.widget.ConstraintLayout>
