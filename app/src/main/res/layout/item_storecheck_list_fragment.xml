<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_marginBottom="@dimen/DP_16"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvStoreCheck"
        style="@style/Text.Label.16.Bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overline_gray_200"
        android:drawablePadding="@dimen/DP_16"
        android:gravity="center_vertical"
        android:padding="@dimen/DP_16"
        android:text="@string/store_check"
        android:textColor="@color/green_primary"
        app:drawableEndCompat="@drawable/ic_arrow_right_gray"
        app:drawableStartCompat="@drawable/ic_check_circle_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAddTask"
        style="@style/Text.Label.14.Bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/DP_16"
        android:layout_marginEnd="@dimen/DP_16"
        android:background="@drawable/bg_8dp_gray_light"
        android:paddingStart="@dimen/DP_40"
        android:paddingTop="@dimen/DP_8"
        android:paddingEnd="@dimen/DP_8"
        android:paddingBottom="@dimen/DP_40"
        android:text="@string/tasks"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvStoreCheck" />

    <ImageView
        android:id="@+id/ivAddTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/DP_8"
        android:layout_marginStart="@dimen/DP_8"
        android:src="@drawable/ic_plus_blue"
        app:layout_constraintStart_toStartOf="@+id/tvAddTask"
        app:layout_constraintTop_toBottomOf="@+id/tvStoreCheck" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTasks"
        android:layout_marginTop="-20dp"
        android:layout_width="match_parent"
        android:layout_marginStart="@dimen/DP_16"
        android:layout_marginEnd="@dimen/DP_16"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAddTask"
        tools:itemCount="3"
        tools:listitem="@layout/item_task" />


    <!--    <androidx.recyclerview.widget.RecyclerView-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="0dp"-->
    <!--        app:layout_constraintTop_toBottomOf="@+id/tvStoreCheck">-->

    <!--    </androidx.recyclerview.widget.RecyclerView>-->
</androidx.constraintlayout.widget.ConstraintLayout>