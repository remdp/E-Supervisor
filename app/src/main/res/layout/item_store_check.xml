<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvStoreCheck"
        style="@style/Text.Label.16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/DP_48"
        android:drawablePadding="@dimen/DP_16"
        android:gravity="center_vertical"
        android:padding="@dimen/DP_16"
        android:text="000214521"
        app:drawableStartCompat="@drawable/ic_check_gray"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvStoreCheckEnd"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:padding="@dimen/DP_16"
        app:drawableEndCompat="@drawable/ic_arrow_right_gray"
        app:layout_constraintBottom_toBottomOf="@+id/tvStoreCheck"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vUnderline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/DP_1"
        android:background="@color/gray_200"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvStoreCheck" />

</androidx.constraintlayout.widget.ConstraintLayout>