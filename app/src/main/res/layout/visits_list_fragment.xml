<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_100"
    android:paddingStart="@dimen/DP_8"
    android:paddingEnd="@dimen/DP_8">

    <include
        android:id="@+id/iSelection"
        layout="@layout/selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tiSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/DP_8"
        app:endIconDrawable="@drawable/ic_cross_grey"
        app:endIconMode="custom"
        app:endIconTint="@color/gray_300"
        app:hintEnabled="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iSelection"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/gray_300">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            style="@style/Text.Label.16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:hint="@string/search"
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbMarks"
        android:layout_width="32dp"
        android:layout_height="40dp"
        app:buttonIcon="@drawable/ic_checkbox_white_off"
        app:buttonTint="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/ivChecker"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivChecker"></com.google.android.material.checkbox.MaterialCheckBox>

    <ImageView
        android:id="@+id/ivChecker"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/DP_4"
        android:layout_marginTop="@dimen/DP_8"
        android:backgroundTint="@color/gray_100"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_visits_list_checker"
        app:layout_constraintStart_toEndOf="@+id/cbMarks"
        app:layout_constraintTop_toBottomOf="@+id/tiSearch" />

    <TextView
        android:id="@+id/tvAllVisits"
        style="@style/Text.Label.12.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/DP_4"
        android:padding="@dimen/DP_4"
        app:layout_constraintBottom_toBottomOf="@+id/ivChecker"
        app:layout_constraintStart_toEndOf="@+id/ivChecker"
        app:layout_constraintTop_toTopOf="@+id/ivChecker"
        tools:text="25 візитів" />

    <TextView
        android:id="@+id/tvRegularVisits"
        style="@style/Text.Label.12.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/DP_4"
        android:drawablePadding="@dimen/DP_4"
        android:padding="@dimen/DP_4"
        app:drawableStartCompat="@drawable/ic_person"
        app:layout_constraintBottom_toBottomOf="@+id/ivChecker"
        app:layout_constraintStart_toEndOf="@+id/tvAllVisits"
        app:layout_constraintTop_toTopOf="@+id/ivChecker"
        tools:text="10/13" />

    <TextView
        android:id="@+id/tvRemoteVisits"
        style="@style/Text.Label.12.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/DP_4"
        android:drawablePadding="@dimen/DP_4"
        android:padding="@dimen/DP_4"
        app:drawableStartCompat="@drawable/ic_phone"
        app:layout_constraintBottom_toBottomOf="@+id/ivChecker"
        app:layout_constraintStart_toEndOf="@+id/tvRegularVisits"
        app:layout_constraintTop_toTopOf="@+id/ivChecker"
        tools:text="2/5" />

    <TextView
        android:id="@+id/tvOneTimeVisits"
        style="@style/Text.Label.12.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/DP_4"
        android:drawablePadding="@dimen/DP_4"
        android:padding="@dimen/DP_4"
        app:drawableStartCompat="@drawable/ic_location_plus_gray"
        app:layout_constraintBottom_toBottomOf="@+id/ivChecker"
        app:layout_constraintStart_toEndOf="@+id/tvRemoteVisits"
        app:layout_constraintTop_toTopOf="@+id/ivChecker"
        tools:text="0/2" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/srl"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/DP_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivChecker">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvList"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/include"
            tools:itemCount="3"
            tools:listitem="@layout/item_visits_list_fragment" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.euromix.esupervisor.app.views.ResultView
        android:id="@+id/vResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAppbarBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:paddingTop="@dimen/DP_8"
        android:paddingBottom="@dimen/DP_8"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/srl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <Button
            android:id="@+id/btnRegular"
            style="@style/Text.Label.14.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/DP_8"
            android:paddingTop="@dimen/DP_12"
            android:paddingBottom="@dimen/DP_12"
            android:text="@string/regular"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnRemote"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnRemote"
            style="@style/Text.Label.14.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/DP_12"
            android:paddingBottom="@dimen/DP_12"
            android:text="@string/remote"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnRegular"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>